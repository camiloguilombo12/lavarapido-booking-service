<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="booking-001-schema-catalog" author="lavarapido">
        <sql>
            IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = 'catalog')
            EXEC('CREATE SCHEMA catalog')
        </sql>
    </changeSet>

    <changeSet id="booking-002-schema-booking" author="lavarapido">
        <sql>
            IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = 'booking')
            EXEC('CREATE SCHEMA booking')
        </sql>
    </changeSet>

    <changeSet id="booking-003-service-type" author="lavarapido">
        <createTable tableName="service_type" schemaName="catalog">
            <column name="service_type_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(20)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
            <column name="base_price" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="duration_minutes" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BIT" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME2" defaultValueComputed="GETDATE()"/>
            <column name="updated_at" type="DATETIME2"/>
        </createTable>
    </changeSet>

    <changeSet id="booking-004-service-offering" author="lavarapido">
        <createTable tableName="service_offering" schemaName="catalog">
            <column name="service_offering_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="service_type_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
            <column name="price" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BIT" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME2" defaultValueComputed="GETDATE()"/>
            <column name="updated_at" type="DATETIME2"/>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="service_offering"
            baseColumnNames="service_type_id"
            constraintName="fk_service_offering_service_type"
            referencedTableName="service_type"
            referencedColumnNames="service_type_id"
            onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="booking-005-location" author="lavarapido">
        <createTable tableName="location" schemaName="catalog">
            <column name="location_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="address" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="VARCHAR(20)"/>
            <column name="is_active" type="BIT" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME2" defaultValueComputed="GETDATE()"/>
            <column name="updated_at" type="DATETIME2"/>
        </createTable>
    </changeSet>

    <changeSet id="booking-006-booking" author="lavarapido">
        <createTable tableName="booking" schemaName="booking">
            <column name="booking_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="booking_code" type="VARCHAR(20)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="customer_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="vehicle_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="service_offering_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="location_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="booking_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="booking_time" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="total_amount" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="VARCHAR(500)"/>
            <column name="created_at" type="DATETIME2" defaultValueComputed="GETDATE()"/>
            <column name="updated_at" type="DATETIME2"/>
            <column name="deleted_at" type="DATETIME2"/>
        </createTable>
    </changeSet>

    <changeSet id="booking-007-booking-status-history" author="lavarapido">
        <createTable tableName="booking_status_history" schemaName="booking">
            <column name="status_history_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="booking_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="changed_at" type="DATETIME2" defaultValueComputed="GETDATE()"/>
            <column name="changed_by" type="VARCHAR(100)"/>
            <column name="notes" type="VARCHAR(500)"/>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="booking_status_history"
            baseColumnNames="booking_id"
            constraintName="fk_booking_status_history_booking"
            referencedTableName="booking"
            referencedColumnNames="booking_id"
            onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="booking-008-schedule" author="lavarapido">
        <createTable tableName="schedule" schemaName="booking">
            <column name="schedule_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="location_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="day_of_week" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="start_time" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="end_time" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="slot_duration_minutes" type="INT" defaultValue="60">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BIT" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME2" defaultValueComputed="GETDATE()"/>
            <column name="updated_at" type="DATETIME2"/>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="schedule"
            baseColumnNames="location_id"
            constraintName="fk_schedule_location"
            referencedTableName="location"
            referencedColumnNames="location_id"
            onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="booking-009-bay" author="lavarapido">
        <createTable tableName="bay" schemaName="booking">
            <column name="bay_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="location_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BIT" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME2" defaultValueComputed="GETDATE()"/>
            <column name="updated_at" type="DATETIME2"/>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="bay"
            baseColumnNames="location_id"
            constraintName="fk_bay_location"
            referencedTableName="location"
            referencedColumnNames="location_id"
            onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="booking-010-booking-bay" author="lavarapido">
        <createTable tableName="booking_bay" schemaName="booking">
            <column name="booking_bay_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="booking_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="bay_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="assigned_at" type="DATETIME2" defaultValueComputed="GETDATE()"/>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="booking_bay"
            baseColumnNames="booking_id"
            constraintName="fk_booking_bay_booking"
            referencedTableName="booking"
            referencedColumnNames="booking_id"
            onDelete="CASCADE"/>
        <addForeignKeyConstraint
            baseTableName="booking_bay"
            baseColumnNames="bay_id"
            constraintName="fk_booking_bay_bay"
            referencedTableName="bay"
            referencedColumnNames="bay_id"
            onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="booking-011-payment" author="lavarapido">
        <createTable tableName="payment" schemaName="booking">
            <column name="payment_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="booking_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="payment_method" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_ref" type="VARCHAR(50)"/>
            <column name="paid_at" type="DATETIME2"/>
            <column name="created_at" type="DATETIME2" defaultValueComputed="GETDATE()"/>
            <column name="updated_at" type="DATETIME2"/>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="payment"
            baseColumnNames="booking_id"
            constraintName="fk_payment_booking"
            referencedTableName="booking"
            referencedColumnNames="booking_id"
            onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="booking-012-promotion" author="lavarapido">
        <createTable tableName="promotion" schemaName="catalog">
            <column name="promotion_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(20)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
            <column name="discount_percent" type="DECIMAL(5,2)">
                <constraints nullable="false"/>
            </column>
            <column name="valid_from" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="valid_until" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BIT" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME2" defaultValueComputed="GETDATE()"/>
            <column name="updated_at" type="DATETIME2"/>
        </createTable>
    </changeSet>

    <changeSet id="booking-013-rating" author="lavarapido">
        <createTable tableName="rating" schemaName="booking">
            <column name="rating_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="booking_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="score" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="comment" type="VARCHAR(500)"/>
            <column name="created_at" type="DATETIME2" defaultValueComputed="GETDATE()"/>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="rating"
            baseColumnNames="booking_id"
            constraintName="fk_rating_booking"
            referencedTableName="booking"
            referencedColumnNames="booking_id"
            onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
